  "components": {
    "schemas": {
      "RequestMetadata": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": {
            "type": "string",
            "example": "req_123"
          }
        }
      },
      "Widget": {
        "type": "object",
        "required": [
          "id",
          "object",
          "displayName",
          "status",
          "createdAt",
          "archivedAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "example": "wid_123"
          },
          "object": {
            "type": "string",
            "enum": ["widget"]
          },
          "displayName": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": ["active", "archived"]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "archivedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        }
      },
      "Gadget": {
        "type": "object",
        "required": ["id", "object"],
        "properties": {
          "id": {
            "type": "string"
          },
          "object": {
            "type": "string",
            "enum": ["gadget"]
          }
        }
      },
      "Sprocket": {
        "type": "object",
        "required": ["id", "object"],
        "properties": {
          "id": {
            "type": "string"
          },
          "object": {
            "type": "string",
            "enum": ["sprocket"]
          }
        }
      },
      "WidgetResponse": {
        "type": "object",
        "required": ["data", "meta"],
        "properties": {
          "data": {
            "$ref": "#/components/schemas/Widget"
          },
          "meta": {
            "type": "object",
            "required": ["request"],
            "properties": {
              "request": {
                "$ref": "#/components/schemas/RequestMetadata"
              }
            }
          }
        }
      },
      "StatusResponse": {
        "type": "object",
        "required": ["data", "meta"],
        "properties": {
          "data": {
            "type": "object",
            "required": ["ok"],
            "properties": {
              "ok": {
                "type": "boolean"
              }
            }
          },
          "meta": {
            "type": "object",
            "required": ["request"],
            "properties": {
              "request": {
                "$ref": "#/components/schemas/RequestMetadata"
              }
            }
          }
        }
      },
      "WidgetList": {
        "type": "object",
        "required": ["object", "data", "meta", "hasMore"],
        "properties": {
          "object": {
            "type": "string",
            "enum": ["list"]
          },
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Widget"
            }
          },
          "meta": {
            "type": "object",
            "required": ["request"],
            "properties": {
              "request": {
                "$ref": "#/components/schemas/RequestMetadata"
              }
            }
          },
          "hasMore": {
            "type": "boolean"
          },
          "nextCursor": {
            "type": "object",
            "nullable": true,
            "description": "Declared as a nullable object, as some real documents do; the value is a string."
          }
        }
      },
      "GadgetList": {
        "type": "object",
        "required": ["object", "data", "meta"],
        "properties": {
          "object": {
            "type": "string",
            "enum": ["list"]
          },
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Gadget"
            }
          },
          "meta": {
            "type": "object",
            "required": ["request"],
            "properties": {
              "request": {
                "$ref": "#/components/schemas/RequestMetadata"
              }
            }
          }
        }
      },
      "SprocketList": {
        "type": "object",
        "required": ["object", "data", "meta", "hasMore"],
        "properties": {
          "object": {
            "type": "string",
            "enum": ["list"]
          },
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Sprocket"
            }
          },
          "meta": {
            "type": "object",
            "required": ["request"],
            "properties": {
              "request": {
                "$ref": "#/components/schemas/RequestMetadata"
              }
            }
          },
          "hasMore": {
            "type": "boolean"
          }
        }
      },
      "WidgetCreate": {
        "type": "object",
        "required": ["displayName"],
        "properties": {
          "displayName": {
            "type": "string"
          }
        }
      },
      "WidgetRename": {
        "type": "object",
        "required": ["displayName"],
        "properties": {
          "displayName": {
            "type": "string"
          }
        }
      }
    }
  }
