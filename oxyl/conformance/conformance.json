    "/api/gadgets": {
      "get": {
        "operationId": "listGadgets",
        "tags": ["gadgets"],
        "description": "List with no paging fields in the body: the next page starts after the last item.",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 25
            }
          },
          {
            "name": "startingAfter",
            "in": "query",
            "required": false,
